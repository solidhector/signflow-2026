package web

// Dashboard is the signed-in landing page. This lesson shows just enough to
// prove auth works; the documents phase fills it with the owner's documents.
templ Dashboard(nav Nav) {
	@Layout("Dashboard", nav) {
		<section class="hero">
			<h1>Welcome back</h1>
			<p class="lead">You're signed in as <strong>{ nav.Email }</strong>.</p>
		</section>
		<section class="card">
			<h2>Your documents</h2>
			<p class="muted">Document upload arrives in the documents phase. For now,
				auth is live: your session is stored server-side and this page is
				protected by <code>RequireAuth</code>.</p>
		</section>
	}
}