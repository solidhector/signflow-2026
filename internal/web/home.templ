package web
// Home is the public landing page. Lesson 3 adds a live user count read from
// Postgres, to prove the whole stack is wired end to end.
templ Home() {
	@Layout("Home") {
		<section class="hero">
			<h1>Sign documents. Keep the receipts.</h1>
			<p class="lead">
				Upload a document, invite signers by email, and collect typed
				signatures. Every action lands in an append-only audit trail.
			</p>
			<div class="cta-row">
				<a class="btn btn-primary" href="/register">Get started</a>
				<a class="btn btn-ghost" href="/login">Log in</a>
			</div>
		</section>
		<section class="status-card">
			<h2>Skeleton status</h2>
			<ul class="checklist">
				<li>✅ Chi router + middleware</li>
				<li>✅ Templ rendering this page</li>
			</ul>
		</section>
	}
}
